{
  "name": "claims-registry-kit",
  "version": "0.1.0",
  "description": "A dependency-free TypeScript library for tracking public claims, their evidence references, and their review freshness.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/claims-registry-kit.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/claims-registry-kit#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/claims-registry-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "product-claims",
    "marketing-claims",
    "evidence-mapping",
    "documentation-drift",
    "staleness-check",
    "compliance",
    "ci",
    "honesty"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
