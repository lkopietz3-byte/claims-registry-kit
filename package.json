{
  "name": "claims-registry-kit",
  "version": "0.1.0",
  "description": "Keep public-facing product claims honest over time by tying each one to an evidence reference and a last-verified date, the SOC2-control-evidence pattern applied to marketing copy instead of compliance controls. Zero runtime dependencies, framework-agnostic TypeScript.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "product-claims",
    "marketing-claims",
    "evidence-mapping",
    "documentation-drift",
    "staleness-check",
    "compliance",
    "ci",
    "honesty"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
